# Copy this file to `.env` and fill in your LLM credentials.
# NEVER commit the real `.env` file.

# --- LLM (OpenAI-compatible Chat Completions API) ---
# Works with OpenAI / DeepSeek / Moonshot / 通义 / 智谱 / OneAPI 等兼容网关
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# Set to 1 to force rule-based fallback (skip LLM even if key is set)
LLM_DISABLED=0
